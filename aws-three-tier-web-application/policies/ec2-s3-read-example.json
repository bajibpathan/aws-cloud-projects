{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApplicationBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::APPLICATION_BUCKET_NAME"
    },
    {
      "Sid": "ReadApplicationArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::APPLICATION_BUCKET_NAME/*"
    }
  ]
}

